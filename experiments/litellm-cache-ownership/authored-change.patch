+def test_default_cache_call_types_are_independent() -> None:
+    first: Final = Cache(type=LiteLLMCacheType.LOCAL)
+    second: Final = Cache(type=LiteLLMCacheType.LOCAL)
+    assert first.supported_call_types is not None
+    assert second.supported_call_types is not None
+    expected: Final = tuple(second.supported_call_types)
+    assert expected
+    first.supported_call_types.clear()
+    third: Final = Cache(type=LiteLLMCacheType.LOCAL)
+    assert second.supported_call_types == list(expected)
+    assert third.supported_call_types == list(expected)
+
+
+def test_explicit_cache_call_types_are_copied_and_none_is_preserved() -> None:
+    supplied: Final = list(DEFAULT_CACHING_SUPPORTED_CALL_TYPES)
+    expected: Final = tuple(supplied)
+    first: Final = Cache(type=LiteLLMCacheType.LOCAL, supported_call_types=supplied)
+    second: Final = Cache(type=LiteLLMCacheType.LOCAL, supported_call_types=supplied)
+    assert first.supported_call_types is not None
+    first.supported_call_types.clear()
+    assert supplied == list(expected)
+    supplied.clear()
+    assert second.supported_call_types == list(expected)
+    assert Cache(type=LiteLLMCacheType.LOCAL, supported_call_types=[]).supported_call_types == []
+    assert Cache(type=LiteLLMCacheType.LOCAL, supported_call_types=None).supported_call_types is None
